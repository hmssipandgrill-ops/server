# ─── Database ─────────────────────────────────────────────────────────────────
# Get free MongoDB Atlas at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/hmslounge?retryWrites=true&w=majority

# ─── JWT Secret ──────────────────────────────────────────────────────────────
# Use a long random string - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ─── Cloudinary (for image uploads) ─────────────────────────────────────────
# Get free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL after deployment
# During local dev, set to http://localhost:5173
CLIENT_URL=https://your-frontend-name.vercel.app

# ─── Auto Seed ───────────────────────────────────────────────────────────────
# Set to 'false' to disable auto admin creation on startup
AUTO_SEED=true

# ─── AYOPOS link (optional) ──────────────────────────────────────────────────
# Leave AYOPOS_API_BASE empty to keep the integration switched off.
AYOPOS_API_BASE=
# Public https address of THIS server (AYOPOS sends signed webhooks here)
PUBLIC_API_URL=
SITE_URL=
# 32+ random characters; encrypts the AYOPOS signing secret at rest (falls back to JWT_SECRET)
INTEGRATION_ENC_KEY=
# What the business shares with AYOPOS
BUSINESS_NAME=HMS Lounge & Bar
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_LOGO_URL=
# 'true' = products created from AYOPOS go live immediately; default keeps them hidden until you review them
AYOPOS_AUTO_PUBLISH=false
